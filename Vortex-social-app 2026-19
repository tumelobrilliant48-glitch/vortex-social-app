<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VORTEX - Created by Brilliant Tumelo Mere</title><link rel="manifest" href="manifest.json"><style>:root{--bg:#050510;--b:rgba(0,216,255,.25);--blue:#00d8ff;--p:#7c3aed;--t:#e6e8ff;--m:#8b8db3}*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:radial-gradient(ellipse at top,#1a1040 0%,#050510 70%);color:var(--t);min-height:100vh}.h{position:sticky;top:0;z-index:9;backdrop-filter:blur(20px);background:rgba(5,5,16,.8);border-bottom:1px solid var(--b);display:flex;justify-content:space-between;padding:12px 16px}.logo{display:flex;gap:10px;font-weight:900;letter-spacing:2px}.logo i{width:34px;height:34px;border-radius:50%;background:conic-gradient(var(--blue),var(--p),var(--blue));display:grid;place-items:center;animation:s 3s linear infinite}@keyframes s{to{transform:rotate(360deg)}}.main{max-width:600px;margin:0 auto;padding:14px;padding-bottom:90px}.card{background:rgba(255,255,255,.06);border:1px solid var(--b);border-radius:18px;padding:14px;margin-bottom:12px;backdrop-filter:blur(12px)}.glow{background:linear-gradient(90deg,var(--blue),var(--p));border:none;color:#fff;padding:11px 20px;border-radius:30px;font-weight:700;width:100%;box-shadow:0 0 18px var(--blue)}input,textarea{width:100%;background:rgba(255,255,255,.05);border:1px solid var(--b);color:#fff;padding:11px;border-radius:11px;margin:6px 0}button{cursor:pointer}.nav{position:fixed;bottom:0;left:0;right:0;background:rgba(5,5,16,.95);border-top:1px solid var(--b);display:flex;justify-content:space-around;padding:8px 0;z-index:20}.nav b{font-size:20px;background:none;border:none}.built{text-align:center;padding:12px;color:var(--m);font-size:11px;border-top:1px solid var(--b)}.built strong{color:var(--blue)}.tab{display:none}.tab.a{display:block}</style></head><body>
<div class="h"><div class="logo"><i>V</i>VORTEX</div><span id="un" style="color:var(--blue);font-size:12px">Guest</span></div>
<div class="main">
<div id="home" class="tab a">
<div class="card" style="background:linear-gradient(135deg,rgba(0,216,255,.15),rgba(124,58,237,.15))"><b>🤖 VORTEX AI</b><div id="greet" style="margin-top:6px">Welcome to VORTEX 🌌<br>Connect • Share • Grow</div><input id="ai" placeholder="Ask: Find gaming communities..."></div>
<div class="card"><textarea id="pc" rows="2" placeholder="What's happening in the Vortex?"></textarea><input id="pi" placeholder="Image URL (optional)"><button class="glow" onclick="post()">POST TO VORTEX ⚡</button></div>
<div id="feed"></div>
</div>
<div id="games" class="tab"><div class="card"><h3>🎮 Games Hub</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px"><div class="card" onclick="play('Chess')">♟️ Chess</div><div class="card" onclick="play('Snooker')">🎱 Snooker</div><div class="card" onclick="play('Racing')">🏎️ Racing</div><div class="card" onclick="play('Puzzle')">🧩 Puzzle</div></div><div id="ga" class="card" style="display:none"></div></div></div>
<div id="profile" class="tab"><div class="card" style="text-align:center"><div style="width:70px;height:70px;margin:0 auto;border-radius:50%;background:conic-gradient(var(--blue),var(--p));display:grid;place-items:center;font-size:28px" id="av">B</div><h2 id="pn">Guest</h2><p id="pu">@guest</p><input id="bio" placeholder="Edit bio..."><button class="glow" onclick="saveBio()">Save</button><div style="margin-top:10px"><input id="em" placeholder="Email"><input id="pw" type="password" placeholder="Password"><button class="glow" onclick="login()">Sign In / Up</button></div></div><div class="card"><b>📊 Creator</b><p>Posts: <span id="pcnt">0</span> | Views: <span id="vcnt">0</span></p></div></div>
</div>
<div class="nav"><b onclick="tab('home')" id="b-home" style="color:var(--blue)">⌂</b><b onclick="tab('games')" id="b-games">🎮</b><b onclick="tab('profile')" id="b-profile">👤</b></div>
<div class="built">Created by <strong>Brilliant Tumelo Mere</strong> • VORTEX © 2026 • Serowe, BW</div>
<script>
let u=JSON.parse(localStorage.getItem('vu')||'null');let posts=JSON.parse(localStorage.getItem('vp')||'[]');
function init(){if(u){document.getElementById('un').textContent=u.n;document.getElementById('pn').textContent=u.n;document.getElementById('pu').textContent='@'+u.n;document.getElementById('av').textContent=u.n[0].toUpperCase();document.getElementById('greet').innerHTML='Welcome back, '+u.n+' 👋<br>What to discover today?';}render();document.getElementById('ai').addEventListener('keydown',e=>{if(e.key==='Enter')ai(e.target.value)});}
function tab(id){document.querySelectorAll('.tab').forEach(t=>t.classList.remove('a'));document.getElementById(id).classList.add('a');document.querySelectorAll('.nav b').forEach(b=>b.style.color='#8b8db3');document.getElementById('b-'+id).style.color='#00d8ff';}
function post(){let c=document.getElementById('pc').value.trim();let im=document.getElementById('pi').value.trim();if(!c)return alert('Type something');if(!u)return alert('Go to Profile tab and Sign In first!');let p={id:Date.now(),user:u.n,c:c,img:im,l:0,t:new Date().toLocaleTimeString()};posts.unshift(p);localStorage.setItem('vp',JSON.stringify(posts));document.getElementById('pc').value='';document.getElementById('pi').value='';render();}
function render(){let f=document.getElementById('feed');if(posts.length==0){f.innerHTML='<div class="card" style="text-align:center;color:#8b8db3">🌌 No posts yet<br>Be first!</div>';return;}f.innerHTML=posts.map(p=>`<div class="card"><b>@${p.user}</b> <span style="font-size:10px;color:#8b8db3">${p.t}</span><p style="margin:8px 0">${p.c}</p>${p.img?`<img src="${p.img}" style="width:100%;border-radius:12px">`:''}<div style="margin-top:8px;color:#8b8db3">💙 ${p.l} <span onclick="like(${p.id})" style="cursor:pointer">Like</span> • 💬 Comment • ↗️ Share</div></div>`).join('');document.getElementById('pcnt').textContent=posts.filter(x=>x.user==u?.n).length;}
function like(id){let p=posts.find(x=>x.id==id);p.l++;localStorage.setItem('vp',JSON.stringify(posts));render();}
function ai(q){if(!q)return;let l=q.toLowerCase();let a="";if(l.includes('gam')){tab('games');a="🎮 Opening Games Hub!";}else if(l.includes('theme')){a="🎨 Themes: Cosmic Blue, Ocean, Purple Space, Aurora";}else{a=`🔍 VORTEX AI: For "${q}" - try creating a post or check Games!`;}document.getElementById('greet').innerHTML='<b>You:</b> '+q+'<br><br><b>AI:</b> '+a;document.getElementById('ai').value='';}
function play(n){let g=document.getElementById('ga');g.style.display='block';g.innerHTML=`<h4>${n}</h4><button class="glow" style="margin-top:8px" onclick="this.textContent='Score: '+Math.floor(Math.random()*1000)+' pts - Saved to VORTEX!'">Play ${n}</button>`;}
function login(){let e=document.getElementById('em').value.trim();if(!e)return alert('Enter email');let name=e.split('@')[0];u={n:name,email:e};localStorage.setItem('vu',JSON.stringify(u));init();alert('✅ Welcome to VORTEX, '+name+'!');tab('home');}
function saveBio(){alert('✅ Bio saved!');}
init();
if('serviceWorker' in navigator)navigator.serviceWorker.register('sw.js');
</script></body></html>